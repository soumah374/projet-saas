# Configuration Django
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL
DB_NAME=project_saas_db
DB_USER=project_saas_user
DB_PASSWORD=project_saas_password
DB_HOST=db
DB_PORT=5432

# Cache Redis
REDIS_URL=redis://redis:6379/0

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=project_saas

# Email (optionnel)
EMAIL_BACKEND = 'django.core.mail.backends.smtp.EmailBackend'
EMAIL_HOST = 'mailpit'  # Nom du service dans docker-compose
EMAIL_PORT = 1025  # Port SMTP de Mailpit
EMAIL_USE_TLS = False  # Mailpit n'utilise pas TLS
EMAIL_USE_SSL = False  # Mailpit n'utilise pas SSL
EMAIL_HOST_USER = ''  # Pas d'authentification requise pour Mailpit
EMAIL_HOST_PASSWORD = ''  # Pas de mot de passe requis pour Mailpit
DEFAULT_FROM_EMAIL = 'noreply@project_saas.com'

# Production (à configurer pour le déploiement)
# DEBUG=False
# SECRET_KEY=your-secure-secret-key-here
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com 