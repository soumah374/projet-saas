# Backend API URL
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=project_saas

# Database
DB_NAME=project_saas_db
DB_USER=project_saas_user
DB_PASSWORD=project_saas_password
DB_HOST=db
DB_PORT=5432

# Django
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production

# Redis
REDIS_URL=redis://redis:6379/0

# Hosts allowed
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Backend Image (for production)
BACKEND_IMAGE=ghcr.io/YOUR_USERNAME/projet-saas/backend:latest

# Frontend Image (for production)
FRONTEND_IMAGE=ghcr.io/YOUR_USERNAME/projet-saas/frontend:latest

# Email configuration (optional)
EMAIL_BACKEND=console  # Use 'smtp' for production
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
